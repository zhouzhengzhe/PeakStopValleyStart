{
  "name": "dsh-peak-valley-brake",
  "version": "0.1.0",
  "private": true,
  "description": "DeepSeek Harness plugin: stop dispatching at peak API pricing, resume automatically off-peak, and never lose the withheld work",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.bundle.js",
    "./time-window": "./lib/time-window.js",
    "./hold-ledger": "./lib/hold-ledger.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "test:quiet": "npm test --silent",
    "hooks:setup": "sh scripts/setup-hooks.sh",
    "prepublishOnly": "node -e \"console.error('This package is installed from a git link, never from the registry. Publishing it would be irreversible and is refused.'); process.exit(1)\""
  },
  "publishConfig": {
    "access": "restricted"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "schemastery": "3.18.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "peak",
    "off-peak",
    "cost"
  ],
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
